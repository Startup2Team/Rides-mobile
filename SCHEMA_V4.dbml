// =====================================================
// RIDES DATABASE SCHEMA v4
// Ride Hailing Platform — Rwanda
// PostgreSQL 15 + PostGIS 3 + pgcrypto
// =====================================================
//
// DESIGN RULES
// 1. PostGIS GEOGRAPHY(POINT,4326) for all spatial columns — never plain decimals for geospatial queries.
// 2. BRIN indexes on append-only time-series tables (ride_events, analytics_events, wallet_transactions, ride_credit_ledger, admin_audit_log).
// 3. Composite PKs on high-write time-series tables (zone_demand_stats) — no UUID overhead.
// 4. Partial indexes on active rides, available drivers, open disputes, pending purchases.
// 5. approval_status values: PENDING_REVIEW | APPROVED | REJECTED | SUSPENDED
// 6. driver_profiles has two ids: id (UUID PK, used by Redis & matching engine) and user_id (auth identity).
// 7. Wallet exists per user for ride fare payments and admin credits. It is NOT used for package purchases (those charge MoMo directly). Wallet-funded purchases are a v2 item.
// 8. PACKAGES ARE VERSIONED: ride_packages = stable identity; ride_package_versions = immutable offer values. Change an offer by creating a new ACTIVE version — existing purchases never change (immutability rule).
// 9. CAMPAIGNS override price/rides/bonus at purchase time (World Cup, weekend, first-purchase). Resolved server-side; highest priority wins.
// 10. CREDITS ARE A LEDGER: ride_credit_ledger is the append-only source of truth (grant / deduct / refund / admin / expiry); driver_entitlements is a cache updated only inside the same transaction. Balances are never edited silently. Bonus rides are spent before regular rides.
// 11. Package purchases: direct MoMo flow — driver initiates → package_purchases row (PENDING, immutable snapshot) → MTN USSD push → /webhooks/momo/callback confirms (idempotent) → ledger credited atomically + credits_granted=TRUE. Free/promotional packages skip MoMo and grant inline. Every attempt is kept (PENDING/PAID/FAILED/CANCELLED/EXPIRED).
// 12. admin_audit_log records every admin write (package/version/campaign/entitlement) with actor + before/after + reason.
// 13. Entitlements are vehicle-type specific (per driver_profiles + vehicle_type); vehicle_id is captured where known for future per-vehicle support.
// =====================================================


// ─────────────────────────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────────────────────────

Table users {
  id                uuid         [pk, default: `gen_random_uuid()`]
  phone_number      varchar(20)  [unique, not null, note: 'E.164 format +250... — primary login identity']
  full_name         varchar(100) [not null]
  email             varchar(100) [unique]
  profile_image_url text
  role_state        varchar(30)  [not null, default: 'CUSTOMER_ONLY', note: 'CUSTOMER_ONLY | DRIVER_PENDING | DRIVER_ACTIVE | BOTH']
  current_mode      varchar(10)  [not null, default: 'customer', note: 'customer | driver — active UI mode for BOTH users']
  fcm_token         varchar(512) [note: 'Latest Firebase push token, updated on every login']
  device_id         varchar(255) [note: 'Latest device fingerprint, denorm from device_sessions for fast auth']
  is_suspended      boolean      [not null, default: false]
  suspension_until  timestamptz
  suspension_reason text
  last_seen_at      timestamptz
  created_at        timestamptz  [not null, default: `now()`]
  updated_at        timestamptz  [not null, default: `now()`]

  indexes {
    phone_number [name: 'idx_users_phone']
    role_state   [name: 'idx_users_role_state']
    (is_suspended) [name: 'idx_users_suspended', note: 'partial WHERE is_suspended = true']
  }

  Note: 'DB trigger trg_create_customer_profile auto-creates customer_profiles row on INSERT. trg_create_wallet auto-creates wallets row on INSERT.'
}

Table otp_verifications {
  id           uuid        [pk, default: `gen_random_uuid()`]
  phone_number varchar(20) [not null]
  otp_hash     text        [not null, note: 'bcrypt hash — never store plaintext']
  purpose      varchar(30) [not null, note: 'REGISTRATION | LOGIN']
  is_used      boolean     [not null, default: false]
  expires_at   timestamptz [not null]
  created_at   timestamptz [not null, default: `now()`]

  indexes {
    (phone_number, purpose, is_used) [name: 'idx_otp_lookup']
    expires_at [name: 'idx_otp_expires', note: 'Nightly purge: DELETE WHERE expires_at < NOW() - 1 day']
  }

  Note: 'Rows purged nightly. FindLatestOTP filters is_used = false AND expires_at > NOW().'
}

Table device_sessions {
  id             uuid         [pk, default: `gen_random_uuid()`]
  user_id        uuid         [not null]
  device_id      varchar(255) [not null]
  platform       varchar(10)  [note: 'ios | android | web']
  app_version    varchar(20)
  fcm_token      text
  ip_address     inet         [note: 'INET type — validates format, supports subnet ops']
  last_active_at timestamptz
  created_at     timestamptz  [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_device_sessions_user_id']
    device_id [name: 'idx_device_sessions_device_id', note: 'Collision detection: find all users sharing a device_id']
    (device_id, user_id) [unique, name: 'uniq_device_user']
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────────────────────────────────────────

Table customer_profiles {
  user_id           uuid         [pk, note: 'FK → users.id  (1:1)']
  total_rides       integer      [not null, default: 0]
  completed_rides   integer      [not null, default: 0]
  cancelled_rides   integer      [not null, default: 0]
  rating            decimal(3,2) [not null, default: 5.0, note: 'Rolling average, recomputed on each new rating']
  preferred_payment varchar(10)  [not null, default: 'cash', note: 'cash | wallet | momo']
  updated_at        timestamptz  [not null, default: `now()`]

  Note: 'Auto-created by trg_create_customer_profile trigger on users INSERT.'
}

Table saved_locations {
  id           uuid          [pk, default: `gen_random_uuid()`]
  user_id      uuid          [not null]
  label        varchar(30)   [not null, note: 'home | work | other']
  custom_label varchar(50)   [note: 'Populated when label = other']
  address      text          [not null]
  lat          decimal(10,7) [not null]
  lng          decimal(10,7) [not null]
  place_id     varchar       [note: 'Mapbox feature ID for frontend dedup']
  use_count    integer       [not null, default: 0]
  created_at   timestamptz   [not null, default: `now()`]
  updated_at   timestamptz   [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_saved_locations_user']
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// VEHICLE TYPES  (static catalog — ~5 rows, always cached in memory)
// ─────────────────────────────────────────────────────────────────────────────

Table vehicle_types {
  id              uuid        [pk, default: `gen_random_uuid()`]
  code            varchar(20) [unique, not null, note: 'MOTO_BIKE | CAB_TAXI | LIGHT_HILUX | HEAVY_FUSO | TUK_TUK']
  display_name    varchar(50) [not null]
  max_passengers  integer     [not null, default: 1]
  credit_cost_rwf integer     [not null, note: 'Default platform fee per COMPLETED ride (e.g. 30/200/100/300/100 RWF). Used as cost_per_ride fallback when driver types a custom payment amount with no package selected. Overridden per-package by ride_packages.cost_per_ride_rwf.']
  icon_url        text
  is_active       boolean     [not null, default: true]
  created_at      timestamptz [not null, default: `now()`]

  Note: 'Fare calculation lives in vehicle_pricing_configs. This table is the type catalog + default per-ride credit cost only.'
}


// ─────────────────────────────────────────────────────────────────────────────
// PRICING ENGINE
// ─────────────────────────────────────────────────────────────────────────────

Table vehicle_pricing_configs {
  id                   uuid         [pk, default: `gen_random_uuid()`]
  vehicle_type_code    varchar(20)  [not null, note: 'FK → vehicle_types.code (UNIQUE col — valid FK target)']
  base_fare_rwf        integer      [not null, note: 'Flat charge for the first base_distance_km']
  base_distance_km     decimal(6,2) [not null, default: 1.0]
  tier1_per_km_rwf     integer      [not null, note: 'Rate per km up to tier1_max_km']
  tier1_max_km         decimal(6,2) [not null]
  tier2_per_km_rwf     integer      [not null, note: 'Rate per km beyond tier1_max_km']
  night_surcharge_pct  decimal(5,4) [not null, default: 0.0, note: '0.30 = 30% surcharge']
  night_start_hour     smallint     [not null, default: 22]
  night_end_hour       smallint     [not null, default: 5]
  waiting_rwf_per_min  decimal(8,2) [not null, default: 0.0]
  waiting_free_minutes smallint     [not null, default: 0]
  min_fare_rwf         integer      [not null, default: 0]
  cancellation_fee_rwf integer      [not null, default: 0]
  is_active            boolean      [not null, default: true]
  effective_from       timestamptz  [not null, default: `now()`]
  created_by           uuid         [note: 'FK → users.id (admin)']
  created_at           timestamptz  [not null, default: `now()`]

  indexes {
    (vehicle_type_code, is_active, effective_from) [name: 'idx_vpc_lookup']
  }

  Note: 'Admin creates a new row to update pricing — history is preserved. Latest is_active row per code wins.'
}


// ─────────────────────────────────────────────────────────────────────────────
// DRIVER
// ─────────────────────────────────────────────────────────────────────────────

Table driver_profiles {
  id                           uuid         [pk, default: `gen_random_uuid()`]
  user_id                      uuid         [unique, not null, note: 'FK → users.id. NOTE: id (not user_id) is stored in Redis GEO and used by the matching engine.']
  permit_number                varchar(50)  [unique, not null, note: 'Rwanda driving permit — permanent business identity. One permit can own many vehicles.']
  momo_phone                   varchar(20)  [note: 'MoMo number for withdrawal, may differ from login phone']
  momo_provider                varchar(10)  [note: 'mtn | airtel']
  province                     varchar(50)
  district                     varchar(50)
  sector                       varchar(50)
  active_vehicle_id            uuid         [note: 'FK → driver_vehicles.id — currently selected vehicle. DEFERRABLE FK (circular).']
  approval_status              varchar(20)  [not null, default: 'PENDING_REVIEW', note: 'PENDING_REVIEW | APPROVED | REJECTED | SUSPENDED']
  approved_by                  uuid         [note: 'FK → users.id (admin who approved)']
  approved_at                  timestamptz
  rejection_reason             text
  suspension_reason            text
  policy_accepted              boolean      [not null, default: false]
  policy_accepted_at           timestamptz
  is_online                    boolean      [not null, default: false, note: 'DB copy of Redis state — synced on WS connect/disconnect. Survives Redis flush.']
  priority_tier                integer      [not null, default: 1, note: '1 = highest priority in matching sort. Lower number wins.']
  acceptance_rate              decimal(5,2) [not null, default: 100.0]
  cancellation_rate            decimal(5,2) [not null, default: 0.0]
  daily_declines               integer      [not null, default: 0, note: 'Reset every midnight by cron']
  suspicious_disconnect_count  integer      [not null, default: 0, note: '3+ mid-ride disconnects in 30 days triggers auto-review']
  rating                       decimal(3,2) [not null, default: 5.0]
  total_rides                  integer      [not null, default: 0]
  total_earnings_rwf           bigint       [not null, default: 0]
  free_trial_used              boolean      [not null, default: false, note: 'One-time free package per driver — set TRUE when first promotional credit is granted']
  created_at                   timestamptz  [not null, default: `now()`]
  updated_at                   timestamptz  [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_dp_user_id']
    approval_status [name: 'idx_dp_approval_status']
    (approval_status, is_online) [name: 'idx_dp_matching', note: 'partial WHERE approval_status = APPROVED AND is_online = TRUE']
    priority_tier [name: 'idx_dp_priority_tier']
  }

  Note: 'Matching engine filters approval_status = APPROVED. FindNearby sorts by priority_tier ASC, distance ASC.'
}

Table driver_vehicles {
  id               uuid         [pk, default: `gen_random_uuid()`]
  driver_id        uuid         [not null, note: 'FK → driver_profiles.id']
  vehicle_type_id  uuid         [not null, note: 'FK → vehicle_types.id']
  plate_number     varchar(20)  [unique, not null, note: 'Rwanda plate e.g. RAD 123 A']
  make             varchar(50)  [note: 'Honda | Toyota | Bajaj | Kiger...']
  model            varchar(50)  [note: 'CB125 | Corolla | Boxer...']
  year             integer
  color            varchar(30)
  passenger_seats  integer
  load_capacity_kg decimal(8,2)
  is_active        boolean      [not null, default: true]
  created_at       timestamptz  [not null, default: `now()`]
  updated_at       timestamptz  [not null, default: `now()`]

  indexes {
    driver_id [name: 'idx_vehicles_driver']
    (driver_id, is_active) [name: 'idx_vehicles_driver_active']
    vehicle_type_id [name: 'idx_vehicles_type']
  }
}

Table driver_documents {
  id            uuid        [pk, default: `gen_random_uuid()`]
  driver_id     uuid        [not null, note: 'FK → driver_profiles.id']
  vehicle_id    uuid        [note: 'FK → driver_vehicles.id. NULL = driver-level doc (permit, national ID). SET = vehicle doc.']
  document_type varchar(30) [not null, note: 'DRIVING_PERMIT | NATIONAL_ID | VEHICLE_INSURANCE | VEHICLE_INSPECTION | VEHICLE_LICENSE']
  file_url      text        [not null, note: 'MinIO / S3 path']
  verified      boolean     [not null, default: false]
  verified_at   timestamptz
  verified_by   uuid        [note: 'FK → users.id (admin)']
  expires_at    date        [note: 'Insurance/inspection expiry — admin sees alerts 14 days before']
  created_at    timestamptz [not null, default: `now()`]

  indexes {
    driver_id [name: 'idx_docs_driver']
    (driver_id, document_type) [unique, name: 'uniq_driver_doc_type']
    (vehicle_id, document_type) [name: 'idx_docs_vehicle']
    expires_at [name: 'idx_docs_expires', note: 'Expiry alert cron: WHERE expires_at < NOW() + 14 days']
  }
}

Table driver_locations {
  driver_id       uuid                   [pk, note: 'FK → driver_profiles.id. One row per driver, updated in-place on every GPS tick.']
  location        geography(point, 4326) [not null, note: 'PostGIS GEOGRAPHY. ST_DWithin + GiST index is the only scalable way to do radius queries.']
  geohash6        varchar(6)             [note: 'Precision-6 geohash (~1.2 km² cell). Precomputed on write for zone_demand_stats.']
  speed_kmh       decimal(6,2)
  heading         decimal(5,2)
  accuracy_meters decimal(7,2)           [note: 'Device GPS accuracy. Used to filter mocked/poor signal.']
  is_available    boolean                [not null, default: false, note: 'Mirrors Redis driver:{id}:state. Written on every state change.']
  is_mocked       boolean                [not null, default: false]
  updated_at      timestamptz            [not null, default: `now()`]

  indexes {
    location [name: 'idx_driver_locations_geo', type: gist]
    (is_available, geohash6) [name: 'idx_driver_locations_avail', note: 'partial WHERE is_available = true']
  }

  Note: 'Source of truth for last-known position. Redis GEO is the hot index for matching but can be rebuilt from this table.'
}

Table driver_sessions {
  id                   uuid        [pk, default: `gen_random_uuid()`]
  driver_id            uuid        [not null, note: 'FK → driver_profiles.id']
  vehicle_id           uuid        [note: 'FK → driver_vehicles.id']
  started_at           timestamptz [not null, default: `now()`]
  ended_at             timestamptz
  total_online_minutes integer     [not null, default: 0]
  rides_completed      integer     [not null, default: 0]
  earnings_rwf         bigint      [not null, default: 0]

  indexes {
    driver_id [name: 'idx_sessions_driver']
    (driver_id, started_at) [name: 'idx_sessions_history']
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// PACKAGES — versioned catalog (v4)
// — Package identity is stable; the buyable offer VALUES live in immutable
//   versions, so changing price/rides never alters existing purchases.
// ─────────────────────────────────────────────────────────────────────────────

Table ride_packages {
  id              uuid        [pk, default: `gen_random_uuid()`]
  vehicle_type_id uuid        [not null, note: 'FK → vehicle_types.id']
  code            varchar(40) [unique, not null, note: 'Stable key: launch_starter | growth | pro']
  display_name    varchar(60) [not null, note: 'Launch Starter Package | Growth Package | Pro Package']
  sort_order      integer     [not null, default: 0]
  is_active       boolean     [not null, default: true, note: 'Visible in the catalog']
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]

  indexes { (vehicle_type_id, is_active) [name: 'idx_packages_active'] }

  Note: 'Identity + metadata only. The buyable offer (rides, bonus, price, validity) lives in ride_package_versions — change an offer by creating a NEW version, never by editing in place.'
}

Table ride_package_versions {
  id                uuid        [pk, default: `gen_random_uuid()`]
  package_id        uuid        [not null, note: 'FK → ride_packages.id']
  version_number    integer     [not null, note: 'Increments per package: 1, 2, 3...']
  rides             integer     [not null, note: 'Base ride credits']
  bonus_rides       integer     [not null, default: 0, note: 'Extra credits included with this version']
  is_unlimited      boolean     [not null, default: false]
  price_rwf         integer     [not null, note: 'Base price. 0 = promotional/free.']
  cost_per_ride_rwf integer     [not null, default: 30, note: 'Platform cost per completed ride for this version']
  validity_days     integer     [not null, default: 30]
  is_promotional    boolean     [not null, default: false, note: 'TRUE = free trial: auto-granted on approval, never sold']
  status            varchar(12) [not null, default: 'DRAFT', note: 'DRAFT | SCHEDULED | ACTIVE | ARCHIVED']
  active_from       timestamptz [note: 'Scheduling window start']
  active_until      timestamptz
  created_by        uuid        [note: 'FK → users.id (admin)']
  created_at        timestamptz [not null, default: `now()`]

  indexes {
    (package_id, version_number) [unique, name: 'uniq_pkg_version']
    (package_id) [unique, name: 'uniq_active_version', note: 'partial WHERE status = ACTIVE — one live version per package']
  }

  Note: 'Value columns are WRITE-ONCE (immutability rule). Only status/active_from/active_until change. Purchases snapshot these values, so editing strategy never rewrites history.'
}


// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGNS — price/ride/bonus overrides resolved at purchase time
// ─────────────────────────────────────────────────────────────────────────────

Table campaigns {
  id                     uuid         [pk, default: `gen_random_uuid()`]
  code                   varchar(40)  [unique, not null]
  name                   varchar(100) [not null, note: 'World Cup | Weekend Boost | First Purchase...']
  type                   varchar(20)  [not null, note: 'GLOBAL | VEHICLE_TYPE | PACKAGE | FIRST_PURCHASE | REFERRAL']
  status                 varchar(12)  [not null, default: 'DRAFT', note: 'DRAFT | SCHEDULED | ACTIVE | EXPIRED | ARCHIVED']
  starts_at              timestamptz
  ends_at                timestamptz
  target_vehicle_type_id uuid         [note: 'FK → vehicle_types.id. NULL = any vehicle type']
  target_package_id      uuid         [note: 'FK → ride_packages.id. NULL = any package']
  override_price_rwf     integer      [note: 'NULL = keep version price']
  override_rides         integer      [note: 'NULL = keep version rides']
  override_bonus_rides   integer      [note: 'NULL = keep version bonus']
  priority               integer      [not null, default: 0, note: 'Highest wins when several campaigns match']
  max_redemptions        integer
  per_driver_limit       integer
  created_by             uuid
  created_at             timestamptz  [not null, default: `now()`]
  updated_at             timestamptz  [not null, default: `now()`]

  indexes { (status, starts_at, ends_at) [name: 'idx_campaigns_window'] }

  Note: 'Resolution: status=ACTIVE, within window, targeting matches; FIRST_PURCHASE applies only when the driver has no prior PAID purchase. GET /driver/packages shows the resolved current price; the same logic re-runs at purchase to freeze the snapshot.'
}


// ─────────────────────────────────────────────────────────────────────────────
// PACKAGE PURCHASES — immutable snapshot + direct-MoMo lifecycle (v4)
// — One row per attempt (PENDING/PAID/FAILED/CANCELLED/EXPIRED — never deleted).
// — Direct MoMo: initiate → MTN USSD push → webhook confirms → ledger credited
//   atomically. No wallet intermediary. Crash-recovery + webhook evidence folded
//   in from the team's payment_requests design.
// ─────────────────────────────────────────────────────────────────────────────

Table package_purchases {
  id                     uuid        [pk, default: `gen_random_uuid()`]
  driver_id              uuid        [not null, note: 'FK → driver_profiles.id — who gets the rides']
  vehicle_id             uuid        [note: 'FK → driver_vehicles.id — the driver vehicle, if resolved']
  vehicle_type_id        uuid        [not null, note: 'FK → vehicle_types.id']

  // ── Frozen offer snapshot (plain values, NOT live FKs — history never moves) ──
  package_id             uuid        [not null, note: 'Snapshot reference to ride_packages.id']
  package_version_id     uuid        [not null, note: 'Snapshot reference to ride_package_versions.id']
  package_version_number integer     [not null]
  package_name           varchar(60) [not null]
  campaign_id            uuid        [note: 'Campaign applied, if any']
  campaign_code          varchar(40)
  price_paid_rwf         integer     [not null, note: 'Exact amount collected (after campaign). Locked at initiation.']
  rides_granted          integer     [not null, note: 'Locked at initiation — never recomputed at webhook time']
  bonus_rides_granted    integer     [not null, default: 0]
  is_unlimited           boolean     [not null, default: false]

  // ── MoMo payment lifecycle ──
  status                 varchar(12)  [not null, default: 'PENDING', note: 'PENDING → PAID | FAILED | CANCELLED | EXPIRED. Terminal states immutable; webhook guards on WHERE status = PENDING.']
  payment_provider       varchar(10)  [note: 'mtn | airtel']
  payment_phone          varchar(20)  [note: 'MSISDN charged — may differ from the driver phone (someone can pay on their behalf)']
  payment_ref            varchar(100) [unique, not null, note: 'Our reference sent to MTN (X-Reference-Id). UNIQUE — O(1) webhook lookup.']
  provider_txn_id        varchar(100) [note: 'MTN transaction id from the webhook. Dedup key for repeat callbacks.']
  idempotency_key        varchar(100) [unique, not null, note: 'Client-supplied; a repeat returns the existing row (double-submit guard).']
  webhook_payload        jsonb        [note: 'Raw MTN callback body, stored verbatim — immutable evidence for disputes.']
  credits_granted        boolean      [not null, default: false, note: 'Set TRUE in the same tx that writes the ledger grant. Crash-recovery job re-runs grants WHERE status=PAID AND credits_granted=FALSE.']
  expires_at             timestamptz  [note: 'initiated_at + 5 min. Expiry worker sets EXPIRED; driver poll then shows "payment timed out".']
  created_at             timestamptz  [not null, default: `now()`]
  paid_at                timestamptz
  updated_at             timestamptz  [not null, default: `now()`]

  indexes {
    payment_ref     [unique, name: 'uniq_purchase_ref', note: 'Primary webhook lookup']
    idempotency_key [unique, name: 'uniq_purchase_idem']
    (driver_id, created_at) [name: 'idx_purchases_driver']
    status [name: 'idx_purchases_status']
    (status, credits_granted) [name: 'idx_purchases_recovery', note: 'partial WHERE status = PAID AND credits_granted = FALSE — crash recovery']
    provider_txn_id [name: 'idx_purchases_provider_txn', note: 'partial WHERE provider_txn_id IS NOT NULL']
  }

  Note: 'Webhook flow (one tx): UPDATE status=PAID WHERE payment_ref=? AND status=PENDING; if 0 rows → already processed, ack & stop; else write PURCHASE_GRANT/BONUS_GRANT ledger rows + bump driver_entitlements + SET credits_granted=TRUE. Promotional/free packages skip MoMo and grant inline at PAID.'
}


// ─────────────────────────────────────────────────────────────────────────────
// ENTITLEMENT LEDGER — append-only credit truth + cached balance (v4)
// — Replaces driver_ride_credits. Every balance change is a ledger row; the
//   cache (driver_entitlements) is only ever updated inside the same tx.
// ─────────────────────────────────────────────────────────────────────────────

Table ride_credit_ledger {
  id                 uuid         [pk, default: `gen_random_uuid()`]
  driver_id          uuid         [not null, note: 'FK → driver_profiles.id']
  vehicle_id         uuid         [note: 'FK → driver_vehicles.id']
  vehicle_type_id    uuid         [not null, note: 'FK → vehicle_types.id']
  entry_type         varchar(20)  [not null, note: 'PURCHASE_GRANT | BONUS_GRANT | RIDE_DEDUCTION | RIDE_REFUND | ADMIN_GRANT | ADMIN_REVOKE | EXPIRY']
  rides_delta        integer      [not null, default: 0, note: '+grant / -deduct (regular rides)']
  bonus_delta        integer      [not null, default: 0, note: '+grant / -deduct (bonus rides)']
  balance_rides      integer      [not null, note: 'Running regular balance after this entry']
  balance_bonus      integer      [not null, note: 'Running bonus balance after this entry']
  source_purchase_id uuid         [note: 'FK → package_purchases.id (grants)']
  source_ride_id     uuid         [note: 'FK → rides.id (deductions/refunds)']
  admin_id           uuid         [note: 'FK → users.id (admin grants/revokes)']
  reason             text
  idempotency_key    varchar(100) [unique, note: 'ride_id for a deduction, refund:<ride_id> for a refund — prevents double apply']
  expires_at         timestamptz  [note: 'Grant entries carry the credit expiry; the expiry worker reads this']
  created_at         timestamptz  [not null, default: `now()`]

  indexes {
    (driver_id, vehicle_type_id, created_at) [name: 'idx_ledger_balance']
    created_at [name: 'idx_ledger_time', type: brin, note: 'BRIN — append-only monotone inserts']
  }

  Note: 'APPEND-ONLY (same self-auditing pattern as wallet_transactions). Bonus rides are spent before regular rides on deduction. Balance = last row per (driver, vehicle_type).'
}

Table driver_entitlements {
  id              uuid        [pk, default: `gen_random_uuid()`]
  driver_id       uuid        [not null, note: 'FK → driver_profiles.id']
  vehicle_id      uuid        [note: 'FK → driver_vehicles.id']
  vehicle_type_id uuid        [not null, note: 'FK → vehicle_types.id']
  rides_remaining integer     [not null, default: 0]
  bonus_remaining integer     [not null, default: 0]
  unlimited_until timestamptz [note: 'Set while an unlimited package is active']
  updated_at      timestamptz [not null, default: `now()`]

  indexes { (driver_id, vehicle_type_id) [unique, name: 'uniq_entitlement'] }

  Note: 'Fast balance cache — the accept-gate and GET /driver/entitlements read this. Updated only inside a ride_credit_ledger transaction; never edited directly.'
}


// ─────────────────────────────────────────────────────────────────────────────
// BONUSES (v4) — folded into campaigns + the ledger.
// The old bonus_tiers / bonus_grants tables are REMOVED in v4. Purchase bonuses
// come from a version's bonus_rides or a campaign's override_bonus_rides, and
// every bonus lands as a BONUS_GRANT row in ride_credit_ledger (audited there).
// ─────────────────────────────────────────────────────────────────────────────


// ─────────────────────────────────────────────────────────────────────────────
// ADMIN AUDIT LOG — every admin write (package / version / campaign / entitlement)
// ─────────────────────────────────────────────────────────────────────────────

Table admin_audit_log {
  id             uuid        [pk, default: `gen_random_uuid()`]
  actor_admin_id uuid        [not null, note: 'FK → users.id (admin)']
  action         varchar(50) [not null, note: 'PACKAGE_VERSION_CREATE | CAMPAIGN_ACTIVATE | ENTITLEMENT_GRANT | ENTITLEMENT_REVOKE | ...']
  entity_type    varchar(30) [not null, note: 'package | package_version | campaign | entitlement | purchase']
  entity_id      uuid
  before         jsonb       [note: 'State before the change']
  after          jsonb       [note: 'State after the change']
  reason         text
  created_at     timestamptz [not null, default: `now()`]

  indexes {
    created_at [name: 'idx_audit_time', type: brin]
    (entity_type, entity_id) [name: 'idx_audit_entity']
    actor_admin_id [name: 'idx_audit_actor']
  }

  Note: 'APPEND-ONLY. Every admin mutation records actor + before/after + reason.'
}


// ─────────────────────────────────────────────────────────────────────────────
// HOT ZONES & DEMAND HEATMAP
// ─────────────────────────────────────────────────────────────────────────────

Table hot_zones {
  id            uuid          [pk, default: `gen_random_uuid()`]
  name          varchar(100)  [not null, note: 'University of Rwanda, Kimironko Market, Nyabugogo Bus Park...']
  category      varchar(30)   [not null, note: 'university | market | transport_hub | hospital | church | hotel | office']
  lat           decimal(10,7) [not null]
  lng           decimal(10,7) [not null]
  geohash6      varchar(6)    [not null]
  radius_meters integer       [not null, default: 500]
  city          varchar(50)   [not null, default: 'Kigali']
  is_active     boolean       [not null, default: true]
  created_at    timestamptz   [not null, default: `now()`]

  indexes {
    geohash6 [name: 'idx_hot_zones_geohash']
    (city, is_active) [name: 'idx_hot_zones_city_active']
  }
}

Table zone_demand_stats {
  geohash6           varchar(6)   [not null, note: 'Precision-6 cell (~1.2 km²)']
  vehicle_type_id    uuid         [not null, note: 'FK → vehicle_types.id']
  hour_bucket        timestamptz  [not null, note: 'date_trunc(hour, NOW()). One row per cell + type + hour.']
  ride_request_count integer      [not null, default: 0]
  completed_count    integer      [not null, default: 0]
  avg_wait_seconds   integer

  indexes {
    (geohash6, vehicle_type_id, hour_bucket) [pk, name: 'pk_zone_demand']
    (geohash6, hour_bucket) [name: 'idx_zone_demand_geo_hour']
  }

  Note: 'Composite PK — no UUID. Upserted via ON CONFLICT DO UPDATE every 15 min from ride_events. Powers driver heatmap.'
}


// ─────────────────────────────────────────────────────────────────────────────
// RIDES
// ─────────────────────────────────────────────────────────────────────────────

Table rides {
  id                        uuid                   [pk, default: `gen_random_uuid()`]
  customer_id               uuid                   [not null, note: 'FK → users.id']
  driver_id                 uuid                   [note: 'FK → driver_profiles.id. NULL until MATCHED.']
  vehicle_type_id           uuid                   [not null, note: 'FK → vehicle_types.id']
  transport_type            varchar(20)            [not null, note: 'Denorm of vehicle_types.code — avoids a join in hot matching/fare/location paths']
  driver_vehicle_id         uuid                   [note: 'FK → driver_vehicles.id — specific vehicle assigned at MATCHED']
  pricing_config_id         uuid                   [note: 'FK → vehicle_pricing_configs.id — snapshot at ride creation for historical accuracy']

  status                    varchar(30)            [not null, default: 'SEARCHING', note: 'SEARCHING | MATCHED | NEGOTIATING | CONFIRMED | DRIVER_EN_ROUTE | DRIVER_ARRIVED | IN_PROGRESS | COMPLETED | CANCELLED | DISPUTED']

  // Pickup
  pickup_lat                decimal(10,7)          [not null]
  pickup_lng                decimal(10,7)          [not null]
  pickup_point              geography(point, 4326) [not null, note: 'PostGIS — driver arrival geofence (ST_DWithin 100 m)']
  pickup_geohash6           varchar(6)
  pickup_address            text                   [not null]
  pickup_place_id           varchar

  // Destination
  dest_lat                  decimal(10,7)          [not null]
  dest_lng                  decimal(10,7)          [not null]
  dest_point                geography(point, 4326) [not null, note: 'PostGIS — journey completion geofence']
  dest_geohash6             varchar(6)
  dest_address              text                   [not null]
  dest_place_id             varchar
  is_generic_dest           boolean                [not null, default: false, note: 'TRUE = destination is flexible (guided). Disables dest geofence.']

  // Fare
  estimated_fare_rwf        integer                [note: 'Shown at booking from route_cache + pricing_config']
  customer_initial_fare_rwf integer                [note: 'Fare shown when customer tapped Request']
  agreed_fare_rwf           integer                [note: 'Final negotiated/locked fare']
  fare_locked_at            timestamptz
  surge_multiplier          decimal(4,2)           [not null, default: 1.0]
  night_surcharge_applied   boolean                [not null, default: false]
  night_surcharge_pct       decimal(5,4)           [not null, default: 0.0]
  waiting_seconds           integer                [not null, default: 0]
  waiting_charge_rwf        decimal(10,2)          [not null, default: 0.0]
  cancellation_fee_rwf      decimal(10,2)          [not null, default: 0.0]
  final_fare_rwf            decimal(10,2)          [note: 'Locked on COMPLETED — source of truth for payment and earnings']

  // Route
  distance_km               decimal(8,2)
  duration_minutes          integer
  route_polyline            text                   [note: 'Encoded Mapbox polyline — stored for replay and dispute resolution']

  // Cancellation
  cancel_reason             text
  cancelled_by              varchar(10)            [note: 'customer | driver | system']
  cancelled_at              timestamptz

  // Pickup expiry
  pickup_expired            boolean                [not null, default: false]
  pickup_expired_at         timestamptz

  // Offline / disconnect
  connection_lost_at        timestamptz
  connection_lost_by        varchar(10)            [note: 'driver | customer | both']
  journey_confirmed         boolean                [not null, default: false]
  journey_confirmed_at      timestamptz
  journey_confirmed_by      varchar(20)            [note: 'driver_self | gps_auto | admin']

  // Payment
  payment_method            varchar(10)            [not null, default: 'cash', note: 'cash | wallet | momo — how the customer pays the driver for the ride fare. Unrelated to how the driver purchased their ride credits.']
  payment_status            varchar(15)            [not null, default: 'PENDING', note: 'PENDING | COMPLETED | DISPUTED | REFUNDED']

  customer_notes            text

  // Timestamps
  requested_at              timestamptz            [not null, default: `now()`]
  matched_at                timestamptz
  confirmed_at              timestamptz
  driver_arrived_at         timestamptz
  started_at                timestamptz
  completed_at              timestamptz
  created_at                timestamptz            [not null, default: `now()`]
  updated_at                timestamptz            [not null, default: `now()`]

  indexes {
    customer_id [name: 'idx_rides_customer_id']
    driver_id [name: 'idx_rides_driver_id']
    status [name: 'idx_rides_status']
    created_at [name: 'idx_rides_created_at']
    pickup_point [name: 'idx_rides_pickup_geo', type: gist]
    dest_point [name: 'idx_rides_dest_geo', type: gist]
    (driver_id, status) [name: 'idx_rides_active_driver', note: 'partial WHERE status NOT IN (COMPLETED,CANCELLED)']
    (customer_id, status) [name: 'idx_rides_active_customer', note: 'partial WHERE status NOT IN (COMPLETED,CANCELLED)']
    (status, created_at) [name: 'idx_rides_status_time']
  }
}

Table ride_events {
  id          uuid        [pk, default: `gen_random_uuid()`]
  ride_id     uuid        [not null, note: 'FK → rides.id']
  actor_id    uuid        [note: 'FK → users.id. NULL for system events.']
  actor_role  varchar(10) [not null, note: 'customer | driver | system | admin']
  event_type  varchar(50) [not null, note: 'ride_created | driver_matched | fare_proposed | fare_accepted | ride_confirmed | driver_en_route | driver_arrived | journey_started | journey_completed | ride_cancelled | connection_lost | journey_confirmed_offline | dispute_raised | credit_deducted']
  payload     jsonb       [note: 'Event-specific structured data']
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    ride_id [name: 'idx_ride_events_ride_id']
    occurred_at [name: 'idx_ride_events_time', type: brin, note: 'BRIN — append-only monotone inserts. ~300x smaller than B-tree.']
  }

  Note: 'APPEND-ONLY. Never UPDATE or DELETE. BRIN index is optimal for this pattern.'
}

Table ride_disputes {
  id                uuid          [pk, default: `gen_random_uuid()`]
  ride_id           uuid          [not null, note: 'FK → rides.id']
  raised_by_id      uuid          [not null, note: 'FK → users.id']
  raised_by_role    varchar(10)   [not null, note: 'customer | driver | system']
  dispute_type      varchar(30)   [not null, note: 'offline_disconnect | false_cancel | payment | behaviour | gps_fraud']
  description       text
  driver_last_lat   decimal(10,7) [note: 'GPS snapshot at moment of dispute']
  driver_last_lng   decimal(10,7)
  customer_last_lat decimal(10,7)
  customer_last_lng decimal(10,7)
  status            varchar(15)   [not null, default: 'OPEN', note: 'OPEN | INVESTIGATING | RESOLVED | DISMISSED']
  resolution        varchar(30)   [note: 'completed_confirmed | cancelled_confirmed | warning_issued | suspended']
  resolved_by       uuid          [note: 'FK → users.id (admin)']
  resolved_at       timestamptz
  created_at        timestamptz   [not null, default: `now()`]

  indexes {
    ride_id [name: 'idx_disputes_ride_id']
    (status, created_at) [name: 'idx_disputes_open', note: 'partial WHERE status = OPEN']
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// NEGOTIATION
// ─────────────────────────────────────────────────────────────────────────────

Table negotiation_rounds {
  id                uuid        [pk, default: `gen_random_uuid()`]
  ride_id           uuid        [not null, note: 'FK → rides.id']
  round_number      integer     [not null, note: '1, 2, 3. Round 3 unlocks the call option.']
  proposed_by       varchar(10) [not null, note: 'customer | driver']
  amount_rwf        integer     [not null]
  response          varchar(10) [note: 'ACCEPTED | DECLINED | EXPIRED | NULL (pending)']
  call_initiated    boolean     [not null, default: false]
  call_initiated_at timestamptz
  expires_at        timestamptz [note: 'Each proposal has a 30 s TTL']
  responded_at      timestamptz
  created_at        timestamptz [not null, default: `now()`]

  indexes {
    ride_id [name: 'idx_negotiation_ride_id']
  }

  Note: 'Max 3 rounds. Acceptance writes agreed_fare_rwf to rides and sets fare_locked_at.'
}


// ─────────────────────────────────────────────────────────────────────────────
// RIDE FARE PAYMENTS & WALLET
// — These cover how the customer pays the driver for a ride (cash/wallet/momo).
// — Completely separate from how the driver purchases ride credits (payment_requests).
// ─────────────────────────────────────────────────────────────────────────────

Table payments {
  id                    uuid        [pk, default: `gen_random_uuid()`]
  ride_id               uuid        [unique, not null, note: 'FK → rides.id. UNIQUE — exactly one payment record per ride.']
  payer_id              uuid        [not null, note: 'FK → users.id (customer)']
  receiver_id           uuid        [not null, note: 'FK → users.id (driver)']
  amount_rwf            integer     [not null, note: 'Total fare paid by customer']
  platform_fee_rwf      integer     [not null, default: 0, note: 'Platform cut — currently 0, ride credits are the monetisation model']
  driver_amount_rwf     integer     [not null, note: 'amount_rwf - platform_fee_rwf']
  payment_method        varchar(10) [not null, note: 'cash | wallet | momo']
  momo_provider         varchar(10) [note: 'mtn | airtel — only when payment_method = momo']
  transaction_reference varchar     [note: 'MoMo gateway reference for this ride payment. Distinct from payment_requests.momo_reference_id which is for credit purchases.']
  status                varchar(15) [not null, default: 'PENDING', note: 'PENDING | COMPLETED | FAILED | REFUNDED']
  paid_at               timestamptz
  created_at            timestamptz [not null, default: `now()`]

  indexes {
    payer_id [name: 'idx_payments_payer']
    receiver_id [name: 'idx_payments_receiver']
  }
}

Table wallets {
  id          uuid        [pk, default: `gen_random_uuid()`]
  user_id     uuid        [unique, not null, note: 'FK → users.id. UNIQUE — one wallet per user regardless of role. Customer switching to driver keeps the same wallet.']
  balance_rwf bigint      [not null, default: 0, note: 'CHECK balance_rwf >= 0. Integer RWF — no decimals needed. Only mutated inside a serialisable transaction with SELECT FOR UPDATE.']
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_wallets_user']
  }

  Note: 'Auto-created by trg_create_wallet trigger on users INSERT. Used for ride fare payments (customer pays driver from wallet balance) and admin-issued credits/refunds. NOT used for driver credit package purchases — those go through payment_requests. Balance MUST only change inside a serialisable DB transaction that also inserts a wallet_transactions row.'
}

Table wallet_transactions {
  id            uuid        [pk, default: `gen_random_uuid()`]
  wallet_id     uuid        [not null, note: 'FK → wallets.id']
  user_id       uuid        [not null, note: 'FK → users.id — denorm for fast per-user history queries without joining wallets']
  type          varchar(25) [not null, note: 'TOP_UP — user loads wallet via MoMo | WITHDRAW — user withdraws to MoMo | RIDE_PAYMENT — customer pays ride fare from wallet | CREDIT_GRANT — admin manually credits wallet (promos, compensation) | REFUND — refund after cancelled or disputed ride']
  amount_rwf    bigint      [not null, note: 'Always positive. Direction implied by type: TOP_UP/CREDIT_GRANT/REFUND = credit; WITHDRAW/RIDE_PAYMENT = debit.']
  balance_after bigint      [not null, note: 'Wallet balance immediately after this transaction. Self-auditing chain: the most recent row balance_after must always equal wallets.balance_rwf.']
  description   text
  phone_number  varchar(20) [note: 'MoMo number used for TOP_UP or WITHDRAW. NULL for internal transactions (RIDE_PAYMENT, CREDIT_GRANT, REFUND).']
  external_ref  varchar(100) [note: 'MoMo gateway transaction ID for TOP_UP and WITHDRAW operations. NULL for internal wallet movements.']
  status        varchar(20) [not null, default: 'COMPLETED', note: 'COMPLETED | PENDING | FAILED. PENDING only during a live MoMo TOP_UP or WITHDRAW gateway call.']
  created_at    timestamptz [not null, default: `now()`]

  indexes {
    (wallet_id, created_at) [name: 'idx_wallet_txn_wallet', note: 'DESC on created_at for efficient history pagination']
    (user_id, created_at)   [name: 'idx_wallet_txn_user',   note: 'Direct user history without wallet join']
    created_at              [name: 'idx_wallet_txn_time', type: brin, note: 'BRIN — inserts are always monotone']
  }

  Note: 'APPEND-ONLY ledger. balance_after creates a self-auditing chain (last row must match wallets.balance_rwf). BRIN ideal for monotone time column. Types: TOP_UP | WITHDRAW | RIDE_PAYMENT | CREDIT_GRANT | REFUND. PACKAGE_PURCHASE is not a type — package purchases go through payment_requests, not the wallet.'
}


// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM SETTINGS  (admin-configurable key-value store)
// ─────────────────────────────────────────────────────────────────────────────

Table platform_settings {
  key        varchar(100) [pk, note: 'commission | negotiation | fares | regions | integrations | notifications | payment | payment_limits']
  value      jsonb        [not null, note: 'Structured JSON per key. commission={moto:15,...} | negotiation={maxRounds:3,...} | fares={motoBase:500,...} | payment={mtn_api_key, mtn_user_id, mtn_subscription_key, airtel_api_key, callback_url} | payment_limits={min_amount_rwf:300, max_amount_rwf:50000, max_daily_amount_rwf:100000, min_rides:1} | integrations={mapbox_token,...}']
  updated_at timestamptz  [not null, default: `now()`]

  Note: 'Key-value config store. Each key has a fixed JSON shape managed by admin. payment key stores MoMo API credentials used by the payment service. payment_limits key controls min/max purchase amounts enforced before calling MTN — prevents accidental large charges and ensures minimum useful purchase.'
}


// ─────────────────────────────────────────────────────────────────────────────
// RATINGS
// ─────────────────────────────────────────────────────────────────────────────

Table ratings {
  id         uuid        [pk, default: `gen_random_uuid()`]
  ride_id    uuid        [not null, note: 'FK → rides.id']
  rater_id   uuid        [not null, note: 'FK → users.id']
  rated_id   uuid        [not null, note: 'FK → users.id']
  direction  varchar(25) [not null, note: 'customer_to_driver | driver_to_customer']
  score      smallint    [not null, note: '1 to 5']
  comment    text
  tags       text[]      [note: 'polite | fast | safe | reckless | no_show | friendly | careful_driving']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (ride_id, rater_id) [unique, name: 'uniq_rating_ride_rater']
    rated_id [name: 'idx_ratings_rated']
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// LANDMARKS & ROUTE CACHE
// ─────────────────────────────────────────────────────────────────────────────

Table landmarks {
  id         uuid          [pk, default: `gen_random_uuid()`]
  name       varchar(100)  [not null]
  category   varchar(30)   [not null, note: 'university | market | hospital | hotel | transport | government | other']
  lat        decimal(10,7) [not null]
  lng        decimal(10,7) [not null]
  geohash6   varchar(6)    [not null]
  city       varchar(50)   [not null, default: 'Kigali']
  is_active  boolean       [not null, default: true]
  created_at timestamptz   [not null, default: `now()`]

  indexes {
    geohash6 [name: 'idx_landmarks_geohash']
    (city, category) [name: 'idx_landmarks_city_category']
  }
}

Table route_cache {
  cache_key        text          [pk, note: 'Natural PK: {origin_geohash6}:{dest_geohash6}:{vehicle_type_code}. O(1) exact lookup — no UUID needed.']
  origin_geohash   varchar(6)    [not null]
  dest_geohash     varchar(6)    [not null]
  vehicle_type     varchar(20)   [not null]
  distance_km      decimal(8,2)  [not null]
  duration_minutes integer       [not null]
  polyline         text          [note: 'Mapbox encoded polyline — served to mobile without re-fetching Directions API']
  agreed_fares     jsonb         [not null, default: '[]', note: 'Ring-buffer of last 10 agreed fares on this route']
  avg_fare_rwf     integer       [note: 'Precomputed average, updated on every new agreed fare']
  use_count        integer       [not null, default: 1]
  expires_at       timestamptz   [not null, note: 'NOW() + 90 days, refreshed on every hit. Nightly purge: DELETE WHERE expires_at < NOW().']
  last_used_at     timestamptz   [not null, default: `now()`]
  created_at       timestamptz   [not null, default: `now()`]

  indexes {
    (origin_geohash, dest_geohash) [name: 'idx_route_cache_pair']
    expires_at [name: 'idx_route_cache_expires']
  }

  Note: 'Redis is L1 cache (hot routes). This table is L2 (survives restarts). Text PK = O(1) lookup.'
}


// ─────────────────────────────────────────────────────────────────────────────
// ANALYTICS
// ─────────────────────────────────────────────────────────────────────────────

Table analytics_events {
  id          bigint       [pk, not null, increment, note: 'BIGSERIAL — lower overhead than UUID at high insert rates']
  event_type  varchar(100) [not null]
  actor_role  varchar(20)
  actor_id    uuid
  ride_id     uuid
  payload     jsonb        [not null, default: '{}']
  occurred_at timestamptz  [not null, default: `now()`]

  indexes {
    event_type [name: 'idx_analytics_event_type']
    ride_id [name: 'idx_analytics_ride_id']
    occurred_at [name: 'idx_analytics_time', type: brin]
  }

  Note: 'Written by background Redis consumer. BIGSERIAL pk avoids UUID generation at high insert rates. BRIN ideal for monotone time column.'
}


// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS & ANOMALIES
// ─────────────────────────────────────────────────────────────────────────────

Table notifications {
  id       uuid         [pk, default: `gen_random_uuid()`]
  user_id  uuid         [not null, note: 'FK → users.id']
  title    varchar(100) [not null]
  body     text         [not null]
  type     varchar(20)  [not null, note: 'ride | payment | package | hot_zone | system | promo']
  data     jsonb        [note: 'Deep-link payload: {ride_id, screen, params}']
  is_read  boolean      [not null, default: false]
  sent_at  timestamptz  [not null, default: `now()`]
  read_at  timestamptz

  indexes {
    (user_id, is_read, sent_at) [name: 'idx_notif_unread', note: 'partial WHERE is_read = false']
    sent_at [name: 'idx_notif_time', type: brin]
  }
}

Table gps_anomalies {
  id            uuid          [pk, default: `gen_random_uuid()`]
  driver_id     uuid          [not null, note: 'FK → driver_profiles.id']
  ride_id       uuid          [note: 'FK → rides.id. NULL if detected outside a ride.']
  anomaly_type  varchar(30)   [not null, note: 'speed_exceeded | mocked_location | teleport | offline_mid_ride']
  speed_kmh     decimal(8,2)
  lat           decimal(10,7)
  lng           decimal(10,7)
  details       jsonb         [note: 'Structured context: {prev_lat, prev_lng, delta_km, delta_seconds}']
  created_at    timestamptz   [not null, default: `now()`]

  indexes {
    driver_id [name: 'idx_anomalies_driver']
    (driver_id, created_at) [name: 'idx_anomalies_driver_time']
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// RELATIONSHIPS
// ─────────────────────────────────────────────────────────────────────────────

// Auth
Ref: customer_profiles.user_id - users.id [delete: cascade]
Ref: device_sessions.user_id > users.id
Ref: saved_locations.user_id > users.id [delete: cascade]

// Driver
Ref: driver_profiles.user_id - users.id [delete: cascade]
Ref: driver_profiles.approved_by > users.id
Ref: driver_profiles.active_vehicle_id > driver_vehicles.id

Ref: driver_vehicles.driver_id > driver_profiles.id [delete: cascade]
Ref: driver_vehicles.vehicle_type_id > vehicle_types.id

Ref: driver_documents.driver_id > driver_profiles.id [delete: cascade]
Ref: driver_documents.vehicle_id > driver_vehicles.id
Ref: driver_documents.verified_by > users.id

Ref: driver_locations.driver_id - driver_profiles.id [delete: cascade]

Ref: driver_sessions.driver_id > driver_profiles.id
Ref: driver_sessions.vehicle_id > driver_vehicles.id

// Pricing
Ref: vehicle_pricing_configs.vehicle_type_code > vehicle_types.code
Ref: vehicle_pricing_configs.created_by > users.id

// Packages, versions & campaigns
Ref: ride_packages.vehicle_type_id > vehicle_types.id
Ref: ride_package_versions.package_id > ride_packages.id [delete: cascade]
Ref: campaigns.target_vehicle_type_id > vehicle_types.id
Ref: campaigns.target_package_id > ride_packages.id

// Package purchases (snapshot columns are values, not enforced FKs)
Ref: package_purchases.driver_id > driver_profiles.id
Ref: package_purchases.vehicle_id > driver_vehicles.id
Ref: package_purchases.vehicle_type_id > vehicle_types.id

// Entitlement ledger + balance cache
Ref: ride_credit_ledger.driver_id > driver_profiles.id
Ref: ride_credit_ledger.vehicle_id > driver_vehicles.id
Ref: ride_credit_ledger.vehicle_type_id > vehicle_types.id
Ref: ride_credit_ledger.source_purchase_id > package_purchases.id
Ref: ride_credit_ledger.source_ride_id > rides.id
Ref: driver_entitlements.driver_id > driver_profiles.id
Ref: driver_entitlements.vehicle_id > driver_vehicles.id
Ref: driver_entitlements.vehicle_type_id > vehicle_types.id

// Admin audit
Ref: admin_audit_log.actor_admin_id > users.id

// Hot zones
Ref: zone_demand_stats.vehicle_type_id > vehicle_types.id

// Rides
Ref: rides.customer_id > users.id
Ref: rides.driver_id > driver_profiles.id
Ref: rides.vehicle_type_id > vehicle_types.id
Ref: rides.driver_vehicle_id > driver_vehicles.id
Ref: rides.pricing_config_id > vehicle_pricing_configs.id

Ref: ride_events.ride_id > rides.id [delete: cascade]
Ref: ride_events.actor_id > users.id

Ref: ride_disputes.ride_id > rides.id
Ref: ride_disputes.raised_by_id > users.id
Ref: ride_disputes.resolved_by > users.id

Ref: negotiation_rounds.ride_id > rides.id [delete: cascade]

// Ride fare payments
Ref: payments.ride_id - rides.id
Ref: payments.payer_id > users.id
Ref: payments.receiver_id > users.id

// Wallet
Ref: wallets.user_id - users.id [delete: cascade]
Ref: wallet_transactions.wallet_id > wallets.id
Ref: wallet_transactions.user_id > users.id

// Ratings
Ref: ratings.ride_id > rides.id
Ref: ratings.rater_id > users.id
Ref: ratings.rated_id > users.id

// Notifications & anomalies
Ref: notifications.user_id > users.id [delete: cascade]
Ref: gps_anomalies.driver_id > driver_profiles.id
Ref: gps_anomalies.ride_id > rides.id
