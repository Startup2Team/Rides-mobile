auto-install-peers=false
strict-peer-dependencies=false

# Required for Expo + Metro with pnpm (see https://docs.expo.dev/guides/monorepos/)
node-linker=hoisted
shamefully-hoist=true

# Explicitly hoist Expo and React Native packages to the workspace root so that
# @expo/metro-config (which lands in root node_modules/) can resolve 'expo' via
# the standard Node require traversal.
#
# Why this is needed even with shamefully-hoist=true:
# pnpm v10 with node-linker=hoisted does NOT automatically hoist workspace-child-
# only dependencies (packages that are only in one workspace package's deps).
# expo is only a dep of artifacts/mobile so it stays in artifacts/mobile/node_modules/.
# @expo/metro-config is hoisted to root and calls require.resolve('expo/package.json')
# from its own location — it can never traverse INTO artifacts/mobile/node_modules/.
# Adding explicit public-hoist-pattern entries forces expo to also land in root.
public-hoist-pattern[]=expo
public-hoist-pattern[]=expo-*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=react-native
public-hoist-pattern[]=react-native-*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=@react-native-community/*
