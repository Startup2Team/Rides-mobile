# ── Backend (REQUIRED) ────────────────────────────────────────────────────────
# Without these the app defaults to LOCAL mode with NO backend URL, so login/OTP
# and every API call silently fail. These are the public STAGING endpoints
# (safe to commit — no secrets). For production, swap stg-api.rides.rw → api.rides.rw.
EXPO_PUBLIC_BACKEND_ENV=STAGING
EXPO_PUBLIC_BACKEND_BASE_URL=https://stg-api.rides.rw/api
EXPO_PUBLIC_API_BASE_URL=https://stg-api.rides.rw/api/v1
EXPO_PUBLIC_WS_BASE_URL=wss://stg-api.rides.rw/api/v1

# Mapbox — required for turn-by-turn routes (Directions API) AND map rendering
# (the default map provider — see components/map/README.md). Same public
# token is used for both; no separate "downloads token" is needed (Mapbox
# lifted that requirement for the SDK version this app uses).
# Get a public token at https://account.mapbox.com/access-tokens/
# Scopes: use the default public token (Directions + Geocoding).
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Which native map SDK renders the app's maps: mapbox (default) or google.
# Build-time only — changing this needs a rebuild, not just a JS reload.
# See components/map/README.md before flipping this to "google".
# EXPO_PUBLIC_MAP_PROVIDER=mapbox

# Optional — OpenStreetMap Nominatim User-Agent (see https://operations.osmfoundation.org/policies/nominatim/)
# EXPO_PUBLIC_NOMINATIM_USER_AGENT=RidesRwanda/1.0 (your@email.com)

# Setup:
# 1. Copy this file to artifacts/mobile/.env
# 2. Paste your Mapbox public token (starts with pk.)
# 3. Restart Expo completely (stop terminal, run pnpm --filter @workspace/mobile exec expo start again)
#
# Monorepo uses pnpm with node-linker=hoisted (see repo root .npmrc).
# Entry: index.js → router-entry.js (avoids OneDrive issues with expo-router/entry hardlinks).
#
# Location search uses OpenStreetMap for hotels & Kigali addresses (no extra API key).
# Mapbox alone does not list most Kigali businesses when country=rw is applied.
