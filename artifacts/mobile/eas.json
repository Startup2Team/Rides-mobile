{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_ENV": "PRODUCTION",
        "EXPO_PUBLIC_BACKEND_BASE_URL": "https://api.rides.rw/api"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_ENV": "PRODUCTION",
        "EXPO_PUBLIC_BACKEND_BASE_URL": "https://api.rides.rw/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
